PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Configuração da MIND original (npm run start:mind).
# Usado apenas para criar o primeiro administrador de um banco vazio.
# ADMIN_PASSWORD: mínimo de 10 e máximo de 128 caracteres.
# Não exige maiúscula, número nem caractere especial. Espaços e caracteres especiais são aceitos.
# Use aspas no valor se contiver espaços ou # para preservar o texto no .env.
# Depois da criação, altere a senha em Meu perfil; editar este arquivo não troca a senha do banco.
ADMIN_EMAIL=admin@mind.local
ADMIN_PASSWORD=troque-por-uma-senha-longa
# sqlite (padrão) ou postgres
DB_PROVIDER=sqlite
SQLITE_PATH=./data/mind.sqlite
# No Supabase: Connect > Session pooler. A senha fica SOMENTE no servidor.
# DATABASE_URL=postgresql://postgres.PROJECT:SENHA@HOST:5432/postgres
# NODE_EXTRA_CA_CERTS=./certs/supabase-ca.crt
# Em HTTPS público:
COOKIE_SECURE=false

# Demonstração Orion: npm start usa o banco pronto abaixo.
# Credenciais fictícias estão em APRESENTACAO_ORION.md.
ORION_DATABASE=./data/orion-demo.sqlite

PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Troque antes de executar. Usado apenas para criar o primeiro administrador.
ADMIN_EMAIL=admin@mind.local
ADMIN_PASSWORD=troque-por-uma-senha-longa
# sqlite (padrão) ou postgres
DB_PROVIDER=sqlite
SQLITE_PATH=./data/mind.sqlite
# No Supabase: Connect > Session pooler. A senha fica SOMENTE no servidor.
# DATABASE_URL=postgresql://postgres.PROJECT:SENHA@HOST:5432/postgres
# NODE_EXTRA_CA_CERTS=./certs/supabase-ca.crt
# Em HTTPS público:
COOKIE_SECURE=false
